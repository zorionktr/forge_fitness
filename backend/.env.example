# Copy to .env and fill. All vars prefixed FORGE_ (see app/core/config.py).
FORGE_ENV=local
FORGE_DEBUG=true

FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge
FORGE_REDIS_URL=redis://localhost:6379/0
FORGE_CELERY_BROKER_URL=redis://localhost:6379/1

FORGE_JWT_SECRET=replace-with-a-long-random-secret
FORGE_GOOGLE_CLIENT_ID=
FORGE_APPLE_CLIENT_ID=

# Email / SMTP (password-reset OTPs). Leave FORGE_SMTP_HOST empty to log codes instead of sending.
# Gmail example: host=smtp.gmail.com port=587 tls=true, user=you@gmail.com, password=<app password>.
FORGE_SMTP_HOST=
FORGE_SMTP_PORT=587
FORGE_SMTP_USER=
FORGE_SMTP_PASSWORD=
FORGE_SMTP_USE_TLS=true
FORGE_SMTP_USE_SSL=false
FORGE_SMTP_FROM=no-reply@forge.app
FORGE_SMTP_FROM_NAME=Forge

FORGE_LLM_PROVIDER=anthropic
FORGE_ANTHROPIC_API_KEY=sk-ant-...
FORGE_MODEL_CHAT=claude-sonnet-4-6
FORGE_MODEL_SMALL=claude-haiku-4-5-20251001
FORGE_MODEL_PREMIUM=claude-opus-4-8

FORGE_S3_BUCKET=forge-media-local
FORGE_S3_ENDPOINT_URL=http://localhost:9000
FORGE_AWS_REGION=us-east-1
FORGE_KAFKA_BOOTSTRAP=localhost:9092
